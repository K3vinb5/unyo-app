<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for the flatpak packaging of Unyo.

  NOTE: this is the starting point for a Flathub submission, not a live flatpak
  (submission itself is tracked in WP 71 section B). Rendered by
  ./render.sh <version> [path/to/SHA256SUMS]; the committed copy is a placeholder.
-->
<component type="desktop-application">
  <id>dev.unyo.Unyo</id>
  <name>Unyo</name>
  <summary>Ad-free anime streaming and manga reader</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause</project_license>
  <developer id="dev.unyo">
    <name>Kevin Rodrigues Borges</name>
  </developer>

  <description>
    <p>
      Unyo is an ad-free anime streaming and manga reader for the desktop. It
      aggregates anime and manga sources, keeps track of your watch and reading
      progress, and ships its own Java runtime so no external JVM is needed.
    </p>
    <p>
      Extensions extend the built-in sources; local playback covers files you
      already have. Everything runs on your machine, with the library stored in
      a local Hive database.
    </p>
  </description>

  <launchable type="desktop-id">dev.unyo.Unyo.desktop</launchable>
  <provides>
    <binary>unyo</binary>
  </provides>

  <url type="homepage">https://unyo.dev</url>
  <url type="bugtracker">https://github.com/K3vinb5/unyo-app/issues</url>
  <url type="vcs-browser">https://github.com/K3vinb5/unyo-app</url>
  <url type="help">https://github.com/K3vinb5/unyo-app#readme</url>

  <translation type="none"/>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">mild</content_attribute>
  </content_rating>

  <categories>
    <category>AudioVideo</category>
  </categories>
  <keywords>
    <keyword>anime</keyword>
    <keyword>manga</keyword>
    <keyword>streaming</keyword>
    <keyword>video</keyword>
  </keywords>

  <releases>
    <release version="0.0.0" date="1970-01-01"/>
  </releases>

  <!-- Flathub requires at least one screenshot; add real ones before submitting.
  <screenshots>
    <screenshot type="default">
      <caption>Home</caption>
      <image>https://unyo.dev/screenshots/home.png</image>
    </screenshot>
  </screenshots>
  -->
</component>
